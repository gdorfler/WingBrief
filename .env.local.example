# WingBrief — optional account/sync backend.
#
# Leave these unset and the app runs entirely in the browser: every feature
# works, progress just does not follow you between devices.
#
# To turn on accounts:
#   1. Create a free project at https://supabase.com
#   2. Run supabase/schema.sql in the SQL editor
#   3. Copy this file to .env.local and paste the two values below
#      (Project Settings -> API)
#   4. Auth -> URL Configuration: add <your-site>/auth/callback to
#      "Redirect URLs", and set "Site URL" to your deployed origin
#
# Both values are safe to expose in the browser. The anon key grants no access
# on its own; Row Level Security in schema.sql is what protects each student's
# data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
